# ─────────────────────────────────────────────────────────────────
#  DevOps Monitoring Dashboard — Development Environment Variables
#  These values are for LOCAL DEVELOPMENT ONLY.
#  Never commit production secrets to version control.
# ─────────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_DB=devops_monitoring
POSTGRES_USER=devops_user
POSTGRES_PASSWORD=devops_password
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8080

# Frontend
FRONTEND_PORT=3000

# JWT — CHANGE THIS IN PRODUCTION
JWT_SECRET=dev-development-secret-key-for-jwt-signing-change-in-production-must-be-at-least-256-bits

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
