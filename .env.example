# ─────────────────────────────────────────────────────────────────
#  DevOps Monitoring Dashboard — Environment Variables Example
#  Copy this file to .env and adjust values for your environment.
#  For production: use strong, randomly generated secrets.
# ─────────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_DB=devops_monitoring
POSTGRES_USER=devops_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8080

# Frontend
FRONTEND_PORT=3000

# JWT Secret — MUST be changed in production (min 32 chars)
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET_WITH_OPENSSL

# CORS Allowed Origins (comma-separated for multiple)
CORS_ORIGINS=https://your-domain.com
